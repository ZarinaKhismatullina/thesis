# Config

RSCRIPT := Rscript --encoding=UTF-8

CONFIG := config/global_cfg.yaml


# Refer to `config/global_cfg.yaml` for file locations

# Output Targets

PAPER := $(shell yq -r '.output_paper' $(CONFIG))

TABLES_FIGURES := $(shell yq -r '.output_tables_figures' $(CONFIG))

TARGETS := $(PAPER)


# Input Targets

PAPER_QMD := $(shell yq -r '.paper_r' $(CONFIG))

TABLES_FIGURES_QMD := $(shell yq -r '.tables_figures_r' $(CONFIG))

EXTERNAL_DATA := $(shell yq -r '.sample_all_listed' $(CONFIG)) \
	$(shell yq -r '.country_characteristics' $(CONFIG))

GENERATED_DATA := $(shell yq -r '.base_sample' $(CONFIG))

RESULTS := $(shell yq -r '.results_r' $(CONFIG))


# Phony Targets

.phony: all clean

all: $(TARGETS)

clean:
	rm -f $(TARGETS)
	rm -f $(TABLES_FIGURES)
	rm -f $(RESULTS)
	rm -f $(GENERATED_DATA)


# Recipes for intermediate targets

$(GENERATED_DATA): $(EXTERNAL_DATA) code/R/prepare_data.R code/R/utils.R $(CONFIG)
	$(RSCRIPT) code/R/prepare_data.R

$(RESULTS): $(GENERATED_DATA) code/R/do_analysis.R code/R/utils.R $(CONFIG)
	$(RSCRIPT) code/R/do_analysis.R

$(TABLES_FIGURES): $(TABLES_FIGURES_QMD) $(RESULTS)
	quarto render $(TABLES_FIGURES_QMD) --quiet


# Recipes for final targets

$(PAPER): $(PAPER_QMD) doc/references.bib $(RESULTS) $(TABLES_FIGURES)
	quarto render $(PAPER_QMD) --quiet
	mv output/paper.pdf $(PAPER)
	rm -f doc/paper.ttt doc/paper.fff
	rm -f $(TABLES_FIGURES)